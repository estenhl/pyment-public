{
    "dataset": {
        "images": "/workspaces/pyment-public/data/ixi/preprocessed",
        "labels": "/workspaces/pyment-public/data/ixi/labels.csv"
    },
    "data_split": {
        "training_fraction": 0.7
    },
    "model": {
        "kind": "sfcn-bin"
    },
    "target": {
        "name": "bachelor",
        "kind": "binary",
        "labels": [false, true]
    },
    "batch_size": 2,
    "num_threads": 4,
    "loss": "binary_crossentropy",
    "metrics": ["accuracy"],
    "epochs": 1,
    "destination": "/workspaces/pyment-public/data/ixi/finetune_output"
}
