{
    "dataset": {
        "images": "/output/fastsurfer",
        "labels": "/labels.csv"
    },
    "data_split": {
        "training_fraction": 0.8
    },
    "model": {
        "kind": "sfcn-reg",
        "input_shape": null,
        "dropout": 0.0
    },
    "target": {
        "name": "age",
        "kind": "regression"
    },
    "pretrained_multitask_weights": "/.pyment/weights/multi-2025.h5",
    "batch_size": 4,
    "num_threads": 4,
    "loss": "mean_squared_error",
    "metrics": ["mean_absolute_error"],
    "optimizer": "adam",
    "epochs": 10,
    "destination": "/output/finetuned_regression_age"
}
