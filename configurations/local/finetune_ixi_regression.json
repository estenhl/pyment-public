{
    "dataset": {
        "images": "$HOME/data/ixi/outputs/fastsurfer",
        "labels": "$HOME/data/ixi/labels.csv"
    },
    "data_split": {
        "training_fraction": 0.8
    },
    "model": {
        "kind": "sfcn-reg"
    },
    "target": {
        "kind": "regression",
        "name": "weight"
    },
    "batch_size": 2,
    "num_threads": 8,
    "loss": "mean_squared_error",
    "metrics": ["mean_absolute_error"],
    "epochs": 100
}
