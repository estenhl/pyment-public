{
    "dataset": {
        "images": "$HOME/data/ds000030/preprocessed",
        "labels": "$HOME/data/ds000030/labels.csv"
    },
    "data_split": {
        "training_fraction": 0.8
    },
    "model": {
        "kind": "sfcn-bin",
        "input_shape": null,
        "dropout": 0.0
    },
    "target": {
        "name": "has_diagnosis",
        "kind": "binary",
        "labels": [false, true]
    },
    "pretrained_multitask_weights": "multi-2025",
    "batch_size": 4,
    "num_threads": 4,
    "loss": "binary_crossentropy",
    "metrics": ["accuracy"],
    "optimizer": "adam",
    "epochs": 10,
    "destination": "$HOME/data/ds000030/finetuned_binary_diagnosis"
}
