{
    "dataset": {
        "images": "$HOME/data/ixi/outputs/fastsurfer",
        "labels": "$HOME/data/ixi/labels.csv"
    },
    "data_split": {
        "training_fraction": 0.8
    },
    "model": {
        "kind": "sfcn-bin"
    },
    "target": {
        "name": "bachelor",
        "labels": [false, true]
    },
    "batch_size": 2,
    "num_threads": 8,
    "loss": "binary_crossentropy",
    "metrics": ["accuracy"],
    "epochs": 100
}
